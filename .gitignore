# macOS
.DS_Store

# Data: never commit audio (see DATA.md)
/data/
*.wav
*.flac

# Model weights and split manifests (rebuilt by scripts/build_manifest.py; checksum in
# DATA.md). Run configs and metrics in artifacts/ stay tracked.
artifacts/**/*.pt
artifacts/**/*.joblib
artifacts/**/splits.json
# Kaggle download leftovers: the raw notebook log, and checksums taken before evaluation
artifacts/**/*.log
artifacts/**/checksums.txt

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Raw research notes, reports built from them, and local working plans
docs/research_notes/
docs/reports/
docs/superpowers/

# Editor settings (personal)
.vscode/
